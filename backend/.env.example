APP_ENV=development
HTTP_PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pekan?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME_MINUTES=30
DB_CONN_MAX_IDLE_MINUTES=5
JWT_SECRET=replace-with-strong-random-secret
RECEIPT_SCAN_SECRET=replace-with-dedicated-receipt-scan-secret
ADMIN_SECRET=replace-with-strong-admin-secret
JWT_ISSUER=pekan-api
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=720
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
REQUEST_BODY_MAX_BYTES=1048576
API_RATE_LIMIT_PER_MINUTE=120
API_RATE_LIMIT_WINDOW_SECONDS=60
API_REQUEST_TIMEOUT_SECONDS=30
MAX_HEADER_BYTES=1048576
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_PREFIX=pekan:ratelimit
FILE_SCAN_POLL_SECONDS=5
FILE_SCAN_MAX_ATTEMPTS=3
FILE_SCAN_RETRY_DELAY_SECONDS=60
REMINDER_POLL_SECONDS=60
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_GDRIVE_FOLDER_ID=
