[Unit]
Description=PEKAN AI Queue Worker Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/pekan/backend
EnvironmentFile=/opt/pekan/backend/.env
ExecStart=/opt/pekan/bin/pekan-ai
Restart=always
RestartSec=5
User=pekan
Group=pekan
StandardOutput=append:/var/log/pekan/ai.log
StandardError=append:/var/log/pekan/ai-error.log

[Install]
WantedBy=multi-user.target
