[Unit]
Description=PEKAN API Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/pekan/backend
EnvironmentFile=/opt/pekan/backend/.env
ExecStart=/opt/pekan/bin/pekan-api
Restart=always
RestartSec=5
User=pekan
Group=pekan
StandardOutput=append:/var/log/pekan/api.log
StandardError=append:/var/log/pekan/api-error.log

[Install]
WantedBy=multi-user.target
