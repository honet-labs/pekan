[Unit]
Description=PEKAN File Scan Worker Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/pekan/backend
EnvironmentFile=/opt/pekan/backend/.env
ExecStart=/opt/pekan/bin/pekan-worker
Restart=always
RestartSec=5
User=pekan
Group=pekan
StandardOutput=append:/var/log/pekan/worker.log
StandardError=append:/var/log/pekan/worker-error.log

[Install]
WantedBy=multi-user.target
